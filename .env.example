# WebSocket endpoint of the GBDS distance-driver channel.
GBDS_WS_URL=ws://localhost:3000/distance-driver

# Project API key. The driver sends this in the WebSocket auth message and in
# the x-api-key header when it reads the project's nodes over REST.
GBDS_API_KEY=replace-me

# Base URL of the GBDS REST API. Optional: defaults to the origin of
# GBDS_WS_URL with ws:// -> http:// (wss:// -> https://).
# GBDS_HTTP_URL=http://localhost:3000

# OSRM routing server. Defaults to the public demo server, which is
# rate limited and has no uptime guarantee — point this at your own
# OSRM instance for anything real.
OSRM_BASE_URL=https://router.project-osrm.org

# Per-attempt timeout, in milliseconds, for both OSRM and the GBDS node
# lookup. Keep 3 attempts x this value well under the 30s the GBDS server
# waits before it gives up on a request.
REQUEST_TIMEOUT_MS=5000

# How many OSRM calls may be in flight at once. GBDS asks for every edge in
# the project the instant the driver authenticates, so this throttles that
# burst rather than firing the whole graph at OSRM simultaneously.
MAX_CONCURRENT_OSRM=4
