# Smart Checkpoints variables are spelled SC_* across the ecosystem. This driver
# also reads the GBDS_* names it originally shipped with, so an existing .env
# keeps working; where both are set, the SC_ one wins.

# WebSocket endpoint of the Smart Checkpoints distance-driver channel.
SC_WS_URL=ws://localhost:3000/distance-driver

# Project API key. The driver sends this in the WebSocket auth message and in
# the x-api-key header when it reads the project's checkpoints over REST.
SC_API_KEY=replace-me

# Base URL of the Smart Checkpoints REST API. Optional: defaults to the
# origin of SC_WS_URL with ws:// -> http:// (wss:// -> https://).
# SC_HTTP_URL=http://localhost:3000

# OSRM routing server. Defaults to the public demo server, which is
# rate limited and has no uptime guarantee. Point this at your own
# OSRM instance for anything real.
OSRM_BASE_URL=https://router.project-osrm.org

# Per-attempt timeout, in milliseconds, for both OSRM and the checkpoint lookup.
# Keep 3 attempts x this value well under the 30s the Smart Checkpoints
# server waits before it gives up on a request.
REQUEST_TIMEOUT_MS=5000

# How many OSRM calls may be in flight at once. The server asks for every
# edge in the project the instant the driver authenticates, so this throttles
# that burst rather than firing the whole graph at OSRM simultaneously.
MAX_CONCURRENT_OSRM=4
